https://doi.org/10.1103/RevModPhys.84.1655</span> </p></div><div class="export-article-citation-container"><button class="export-article-citation" data-action="click-&gt;export-citation#open" data-component-type="dialog_trigger">Export Citation</button></div></div><div class="pt-4" data-controller="disclosure" id="metrics"><div class="grid tablet:flex w-[100%] pb-4" id="metrics-panel"><div class="flex gap-4 w-[100%]"><div class="altmetric-wrapper w-1/2" id="altmetric"><div class="altmetric-rectangle" id="altmetric-header"><div class="altmetric-embed flex items-start px-0 pb-4" data-badge-type="1" data-doi="10.1103/RevModPhys.84.1655" data-link-target="_blank" id="altmetric-rectangle"><div class="metrics-buttons sm-desktop:justify-self-end whitespace-nowrap"></div></div></div></div><div class="dimensions-wrapper w-1/2" id="dimensions"><div class="content-start justify-between grid tablet:flex"><div class="dimensions-rectangle pb-4"><span class="__dimensions_badge_embed__" data-doi="10.1103/RevModPhys.84.1655" data-hide-zero-citations="true" data-legend="never" data-style="large_rectangle" id="dimensions-rectangle"></span></div></div></div></div><div class="metrics-buttons sm-desktop:justify-self-end whitespace-nowrap"><button aria-controls="expanded-altmetric expanded-dimensions" aria-expanded="false" class="metrics-toggle xs-tertiary-button" data-action="disclosure#toggle" data-disclosure-target="button" type="button"><span data-disclosure-target="showLabel">Show metrics</span><span class="hidden" data-disclosure-target="hideLabel">Hide metrics</span><svg aria-hidden="true" class="chevron-down" data-disclosure-target="showIcon" fill="none" height="12" viewBox="0 0 12 12" width="12"><title>open icon</title><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><svg aria-hidden="true" class="hidden chevron-up" data-disclosure-target="hideIcon" fill="none" height="12" viewBox="0 0 12 12" width="12"><title>close icon</title><path d="M9 7.5L6 4.5L3 7.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg></button></div></div><script>document.addEventListener('DOMContentLoaded', function() {
  const metricsContainer = document.querySelector('div#metrics')
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      const altmetricLink = document.querySelector('p.altmetric-see-more-details a'); 
