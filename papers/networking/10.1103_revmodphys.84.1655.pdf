window.addEventListener('load', function() {
  // init the seamless button with the current url as the return point
  const authRedirect = new URLSearchParams(window.location.search).get('rt') || window.location.href;
  if (window.thiss && window.thiss.DiscoveryComponent) {
    const seamlessLoginUrl = new URL('/auth/openathens/login', window.location.origin);
    seamlessLoginUrl.searchParams.set('rt', authRedirect);

    window.thiss.DiscoveryComponent.render({
      loginInitiatorURL: seamlessLoginUrl.toString()
    }, '#seamlessLoginButton');
  }

  // add the return url for the login link in the modal
  const loginDialog = document.getElementById('login-dialog');
  if (loginDialog) { 
    const institutionLink = loginDialog.querySelector('#sign-in-via-institution-link');
    if (institutionLink) {
      const institutionUrl = new URL(institutionLink.getAttribute('href'), window.location.origin);
      institutionUrl.searchParams.set('rt', authRedirect);
      institutionLink.href = institutionUrl.toString();
    }
  }
});</script><script>window.__CF$cv$params={r:'a46bf4748c4b9e24',t:'MTc5MTM2NjEzNw==',u:'01a115be075776f39dfdcadd5326626f',ut:'cuXIZEF_Tlqw5i6UKFRVmC2zRPFeddSg6qZ8JfPeVxI-1791366137-1.2.1.1-MoyM9f0ozZUGZANZ1G.Ts_3mSrT_PD5EvsQMgB5e0Jd4k7rAzMShsGUpJP.E5F57iH58WBoDMvfefGgIhw7LD6A8cUuAbX0nXgnjJFiNrb0',i:60};(function(){if(!document.body)return;var s=document.createElement('script');s.src='/cdn-cgi/challenge-platform/scripts/precursor/main.js';document.head.appendChild(s);})();</script></body></html>