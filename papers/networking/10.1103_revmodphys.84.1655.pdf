      MathJax.startup = {
        ready() {
          const {LinebreakVisitor} = MathJax._.output.common.LinebreakVisitor;
          class myLinebreakVisitor extends LinebreakVisitor {
            visitNode(wrapper, i) {
              if (wrapper) {
                super.visitNode(wrapper, i);
              }
            }
          };
          MathJax.config.output.linebreaks = MathJax.config.chtml.linebreaks = {LinebreakVisitor: myLinebreakVisitor};
          MathJax.startup.defaultReady();
          // MathJax gives a bare multi-letter <mi> operator spacing (like "sin"), so chemical
          // formulas typeset as <msub><mi>EuIn</mi>..</msub><msub><mi>As</mi>..</msub> render
          // "EuIn2 As2". Mark element-symbol <mi>s as ORD so they sit tight.
          const elements = new Set(('H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe Co Ni ' +
            'Cu Zn Ga Ge As Se Br Kr Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe Cs Ba La Ce Pr Nd Pm ' +
            'Sm Eu Gd Tb Dy Ho Er Tm Yb Lu Hf Ta W Re Os Ir Pt Au Hg Tl Pb Bi Po At Rn Fr Ra Ac Th Pa U Np Pu ' +
            'Am Cm Bk Cf Es Fm Md No Lr Rf Db Sg Bh Hs Mt Ds Rg Cn Nh Fl Mc Lv Ts Og').split(' '));
          // Units that spell element symbols (Ge+V, Te+V); they keep their spacing (5 GeV).
          const units = new Set(['GeV', 'TeV']);
          // Also operator names or units (Re z, Pr, 5 Pa); only chemical when scripted (Re2O7).
          const ambiguous = new Set(['Re', 'Pr', 'Pa']);
          const isChemical = (text) => !units.has(text) && /^(?:[A-Z][a-z]?)+$/.test(text) &&
            text.match(/[A-Z][a-z]?/g).every((symbol) => elements.has(symbol));
          const chemicalMiAsOrd = ({data}) => {
            if (!data || !data.querySelectorAll) return;
            for (const mi of data.querySelectorAll('mi')) {
              const text = mi.textContent.trim();
              if (text.length < 2 || !isChemical(text) || mi.hasAttribute('data-mjx-texclass')) continue;
              const parent = mi.parentElement;
              const scripted = /^(msub|msup|msubsup)$/.test(parent.localName) && parent.firstElementChild === mi;
              if (ambiguous.has(text) && !scripted) continue;
              mi.setAttribute('data-mjx-texclass', 'ORD');
            }
          };
          for (const jax of MathJax.startup.document.inputJax) {
            if (jax.name === 'MathML') jax.mmlFilters.add(chemicalMiAsOrd);
          }
        }
      }
      </script>
